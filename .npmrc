# pnpm .npmrc configuration
# Allow build scripts for known, safe native build tools
# These are required for Next.js + Vitest to function
# @parcel/watcher - file system watcher (needed by Next.js dev)
# @swc/core - SWC transpiler (needed by Next.js)
# esbuild - bundler (needed by Vitest)
approve-builds[]=@parcel/watcher
approve-builds[]=@swc/core
approve-builds[]=esbuild
