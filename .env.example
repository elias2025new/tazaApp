# Copy to .env.local and fill in. NEVER commit .env.local.
# Vercel: set the same keys per environment (Preview -> dev Supabase, Production -> prod Supabase).

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=              # from BotFather. SERVER ONLY.
TELEGRAM_BOT_USERNAME=           # without the @
TELEGRAM_WEBHOOK_SECRET=         # random 32+ chars; the agent generates this
TELEGRAM_STAFF_CHAT_ID=          # chat/group id that receives new-order alerts

# ---------- App ----------
NEXT_PUBLIC_APP_URL=             # public https URL (Vercel URL or tunnel while developing)
NEXT_PUBLIC_DEFAULT_LOCALE=en    # en | am

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon / publishable key (safe for client, protected by RLS)
SUPABASE_SERVICE_ROLE_KEY=       # service_role / secret key. SERVER ONLY.
SUPABASE_JWT_SECRET=             # SERVER ONLY. Used to mint the Telegram session JWT (see ADR-003).
SUPABASE_DB_PASSWORD=            # CLI linking only. Never used by the app.

# ---------- Maps ----------
NEXT_PUBLIC_MAP_TILE_KEY=        # tile provider key (MapTiler/Stadia free tier)

# ---------- Dev only ----------
NEXT_PUBLIC_DEV_MOCK_TELEGRAM=false   # true = fake initData in local browser. Must be false in prod.
